+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "WebGPUWindowsDawnGPU.h"
+
+#if PLATFORM(WIN) && ENABLE(WEBGPU)
+
+#include "WebGPUWindowsDawnAdapter.h"
+#include <memory>
+#include <windows.h>
+#include <wtf/NeverDestroyed.h>
+
+namespace WebCore::WebGPU {
+
+using CreateInstanceFunction = WindowsDawnInstanceHandle (*)(const WGPUInstanceDescriptor*);
+using RequestAdapterFunction = void (*)(WindowsDawnInstanceHandle, const WGPURequestAdapterOptions*, WGPURequestAdapterCallback, void*);
+using ProcessEventsFunction = void (*)(WindowsDawnInstanceHandle);
+using ReleaseAdapterFunction = void (*)(WindowsDawnAdapterHandle);
+
+static constexpr auto requestAdapterStatusSuccess = WGPURequestAdapterStatus_Success;
+
+enum class NGWebGPUBackend : uint8_t {
+    Default,
+    D3D12,
+    Vulkan,
+    D3D11,
+    Null,
+};
+
+static WGPUBackendType toWGPUBackendType(NGWebGPUBackend backend)
+{
+    switch (backend) {
+    case NGWebGPUBackend::Default:
+    case NGWebGPUBackend::D3D12:
+        return WGPUBackendType_D3D12;
+    case NGWebGPUBackend::Vulkan:
+        return WGPUBackendType_Vulkan;
+    case NGWebGPUBackend::D3D11:
+        return WGPUBackendType_D3D11;
+    case NGWebGPUBackend::Null:
+        return WGPUBackendType_Null;
+    }
+
+    return WGPUBackendType_D3D12;
+}
+
+static WGPUBackendType windowsDawnBackendType()
+{
+    return toWGPUBackendType(NGWebGPUBackend::Default);
+}
+
+static WGPUPowerPreference toWGPUPowerPreference(const RequestAdapterOptions& options)
+{
+    if (!options.powerPreference)
+        return WGPUPowerPreference_HighPerformance;
+
+    switch (*options.powerPreference) {
+    case PowerPreference::LowPower:
+        return WGPUPowerPreference_LowPower;
+    case PowerPreference::HighPerformance:
+        return WGPUPowerPreference_HighPerformance;
+    }
+
+    return WGPUPowerPreference_HighPerformance;
+}
+
+class DawnLibrary {
+public:
+    static DawnLibrary& singleton()
+    {
+        static NeverDestroyed<DawnLibrary> library;
+        return library;
+    }
+
+    CreateInstanceFunction createInstance() const { return m_createInstance; }
+    RequestAdapterFunction requestAdapter() const { return m_requestAdapter; }
+    ProcessEventsFunction processEvents() const { return m_processEvents; }
+    WindowsDawnGPU::ReleaseInstanceFunction releaseInstance() const { return m_releaseInstance; }
+    ReleaseAdapterFunction releaseAdapter() const { return m_releaseAdapter; }
+
+private:
+    friend class NeverDestroyed<DawnLibrary>;
+
+    DawnLibrary()
+    {
+        m_module = LoadLibraryW(L"webgpu_dawn.dll");
+        if (!m_module)
+            m_module = LoadLibraryW(L"dawn.dll");
+        if (!m_module)
+            return;
+
+        m_createInstance = reinterpret_cast<CreateInstanceFunction>(GetProcAddress(m_module, "wgpuCreateInstance"));
+        m_requestAdapter = reinterpret_cast<RequestAdapterFunction>(GetProcAddress(m_module, "wgpuInstanceRequestAdapter"));
+        m_processEvents = reinterpret_cast<ProcessEventsFunction>(GetProcAddress(m_module, "wgpuInstanceProcessEvents"));
+        m_releaseInstance = reinterpret_cast<WindowsDawnGPU::ReleaseInstanceFunction>(GetProcAddress(m_module, "wgpuInstanceRelease"));
+        m_releaseAdapter = reinterpret_cast<ReleaseAdapterFunction>(GetProcAddress(m_module, "wgpuAdapterRelease"));
+    }
+
+    HMODULE m_module { nullptr };
+    CreateInstanceFunction m_createInstance { nullptr };
+    RequestAdapterFunction m_requestAdapter { nullptr };
+    ProcessEventsFunction m_processEvents { nullptr };
+    WindowsDawnGPU::ReleaseInstanceFunction m_releaseInstance { nullptr };
+    ReleaseAdapterFunction m_releaseAdapter { nullptr };
+};
+
+RefPtr<WindowsDawnGPU> WindowsDawnGPU::create()
+{
+    auto& dawn = DawnLibrary::singleton();
+    if (!dawn.createInstance() || !dawn.requestAdapter())
+        return nullptr;
+
+    auto instance = dawn.createInstance()(nullptr);
+    if (!instance)
+        return nullptr;
+
+    return adoptRef(*new WindowsDawnGPU(instance, dawn.releaseInstance()));
+}
+
+WindowsDawnGPU::WindowsDawnGPU(WindowsDawnInstanceHandle instance, ReleaseInstanceFunction releaseInstance)
+    : m_instance(instance)
+    , m_releaseInstance(releaseInstance)
+{
+}
+
+WindowsDawnGPU::~WindowsDawnGPU()
+{
+    if (m_instance && m_releaseInstance)
+        m_releaseInstance(m_instance);
+}
+
+struct RequestAdapterContext {
+    CompletionHandler<void(RefPtr<Adapter>&&)> callback;
+    ReleaseAdapterFunction releaseAdapter { nullptr };
+};
+
+void WindowsDawnGPU::requestAdapter(const RequestAdapterOptions& options, CompletionHandler<void(RefPtr<Adapter>&&)>&& callback)
+{
+    auto& dawn = DawnLibrary::singleton();
+    if (!m_instance || !dawn.requestAdapter()) {
+        callback(nullptr);
+        return;
+    }
+
+    WGPURequestAdapterOptions backingOptions {
+        .compatibleSurface = nullptr,
+        .powerPreference = toWGPUPowerPreference(options),
+        .backendType = windowsDawnBackendType(),
+        .forceFallbackAdapter = options.forceFallbackAdapter,
+        .xrCompatible = options.xrCompatible,
+    };
+
+    auto* context = new RequestAdapterContext { WTF::move(callback), dawn.releaseAdapter() };
+    dawn.requestAdapter()(m_instance, &backingOptions, [](WGPURequestAdapterStatus status, WindowsDawnAdapterHandle adapter, const char*, void* userdata) {
+        std::unique_ptr<RequestAdapterContext> context { static_cast<RequestAdapterContext*>(userdata) };
+        if (status == requestAdapterStatusSuccess && adapter) {
+            context->callback(WindowsDawnAdapter::create(adapter, context->releaseAdapter));
+            return;
+        }
+        context->callback(nullptr);
+    }, context);
+
+    if (dawn.processEvents())
+        dawn.processEvents()(m_instance);
+}
+
+} // namespace WebCore::WebGPU
+
+#endif // PLATFORM(WIN) && ENABLE(WEBGPU)
