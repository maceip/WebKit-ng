+
+using WindowsDawnInstanceHandle = WGPUInstance;
+
+class WindowsDawnGPU final : public GPU, public RefCounted<WindowsDawnGPU> {
+public:
+    using ReleaseInstanceFunction = void (*)(WindowsDawnInstanceHandle);
+
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+
+    static RefPtr<WindowsDawnGPU> create();
+    ~WindowsDawnGPU();
+
+    void requestAdapter(const RequestAdapterOptions&, CompletionHandler<void(RefPtr<Adapter>&&)>&&) final;
+
+    RefPtr<PresentationContext> createPresentationContext(const PresentationContextDescriptor&) final { return nullptr; }
+    RefPtr<CompositorIntegration> createCompositorIntegration() final { return nullptr; }
+    void paintToCanvas(WebCore::NativeImage&, const WebCore::IntSize&, WebCore::GraphicsContext&) final { }
+
+    bool isValid(const CompositorIntegration&) const final { return false; }
+    bool isValid(const Buffer&) const final { return false; }
+    bool isValid(const Adapter&) const final { return true; }
+    bool isValid(const BindGroup&) const final { return false; }
+    bool isValid(const BindGroupLayout&) const final { return false; }
+    bool isValid(const CommandBuffer&) const final { return false; }
+    bool isValid(const CommandEncoder&) const final { return false; }
+    bool isValid(const ComputePassEncoder&) const final { return false; }
+    bool isValid(const ComputePipeline&) const final { return false; }
+    bool isValid(const Device&) const final { return false; }
+    bool isValid(const ExternalTexture&) const final { return false; }
+    bool isValid(const PipelineLayout&) const final { return false; }
+    bool isValid(const PresentationContext&) const final { return false; }
+    bool isValid(const QuerySet&) const final { return false; }
+    bool isValid(const Queue&) const final { return false; }
+    bool isValid(const RenderBundleEncoder&) const final { return false; }
+    bool isValid(const RenderBundle&) const final { return false; }
+    bool isValid(const RenderPassEncoder&) const final { return false; }
+    bool isValid(const RenderPipeline&) const final { return false; }
+    bool isValid(const Sampler&) const final { return false; }
+    bool isValid(const ShaderModule&) const final { return false; }
+    bool isValid(const Texture&) const final { return false; }
+    bool isValid(const TextureView&) const final { return false; }
+    bool isValid(const XRBinding&) const final { return false; }
+    bool isValid(const XRSubImage&) const final { return false; }
+    bool isValid(const XRProjectionLayer&) const final { return false; }
+    bool isValid(const XRView&) const final { return false; }
+
+private:
+    WindowsDawnGPU(WindowsDawnInstanceHandle, ReleaseInstanceFunction);
+
+    WindowsDawnInstanceHandle m_instance { nullptr };
+    ReleaseInstanceFunction m_releaseInstance { nullptr };
+};
+
+} // namespace WebCore::WebGPU
