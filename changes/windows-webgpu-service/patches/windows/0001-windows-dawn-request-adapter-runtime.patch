+
+#if PLATFORM(WIN) && ENABLE(WEBGPU)
+
+#include "WebGPUSupportedFeatures.h"
+#include "WebGPUSupportedLimits.h"
+
+namespace WebCore::WebGPU {
+
+static Ref<SupportedLimits> minimumWebGPULimits()
+{
+    return SupportedLimits::create(
+        8192, 8192, 2048, 256,
+        4, 24, 1000,
+        8, 4,
+        16, 16, 8, 4, 12,
+        65536, 134217728,
+        256, 256,
+        8, 268435456,
+        16, 2048,
+        60, 16,
+        8, 32,
+        16384, 256,
+        256, 256, 64,
+        65535,
+        8, 4, 8, 4);
+}
+
+Ref<WindowsDawnAdapter> WindowsDawnAdapter::create(WindowsDawnAdapterHandle adapter, ReleaseAdapterFunction releaseAdapter)
+{
+    return adoptRef(*new WindowsDawnAdapter(adapter, releaseAdapter, SupportedFeatures::create({ }), minimumWebGPULimits()));
+}
+
+WindowsDawnAdapter::WindowsDawnAdapter(WindowsDawnAdapterHandle adapter, ReleaseAdapterFunction releaseAdapter, Ref<SupportedFeatures>&& features, Ref<SupportedLimits>&& limits)
+    : Adapter("Dawn D3D12"_s, features, limits, false)
+    , m_adapter(adapter)
+    , m_releaseAdapter(releaseAdapter)
+{
+}
+
+WindowsDawnAdapter::~WindowsDawnAdapter()
+{
+    if (m_adapter && m_releaseAdapter)
+        m_releaseAdapter(m_adapter);
+}
+
+void WindowsDawnAdapter::requestDevice(const DeviceDescriptor&, CompletionHandler<void(RefPtr<Device>&&)>&& callback)
+{
+    callback(nullptr);
+}
+
+} // namespace WebCore::WebGPU
+
+#endif // PLATFORM(WIN) && ENABLE(WEBGPU)
